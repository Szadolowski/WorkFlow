generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMY
// ==========================================
enum AbsenceType {
  HOLIDAY
  SICK_LEAVE
  UNEXCUSED
  SPECIAL
}

enum CertificationType {
  BHP
  MEDICAL
  UDT
  OTHER
}

enum ContractType {
  UOP
  UZ
  UD
  B2B
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum TimeEventAction {
  IN
  OUT
}

enum UserRole {
  ADMIN
  HR
  OFFICE
  FOREMAN
  ACCOUNTING
  WORKER
}

// ==========================================
// MODELE (MULTI-TENANCY / ZAKŁADY)
// ==========================================

model Facility {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(500)
  code        String?   @unique @db.VarChar(255) // Wewnętrzny kod zakładu, przydatny np. dla księgowości
  address     String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @updatedAt @db.Timestamp(6)

  // Relacje - wszystko co jest podpięte pod dany zakład
  employees   Employee[]
  accessUsers EmployeeFacilityAccess[]
  projects    Project[]
  readers     Reader[]
}

// ==========================================
// GŁÓWNE MODELE BIZNESOWE
// ==========================================

model Employee {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId         String    @db.Uuid // [NOWE] Przypisanie do zakładu
  firstName          String    @db.VarChar(500)
  lastName           String    @db.VarChar(500)
  pesel              String?   @unique @db.VarChar(11)
  rfidCardId         String?   @unique @db.VarChar(500)
  email              String?   @unique @db.VarChar(500)
  passwordHash       String?   @db.VarChar(500)
  role               UserRole  @default(WORKER)
  isActive           Boolean   @default(true)
  isLoginEnabled     Boolean   @default(false)
  isTwoFactorEnabled Boolean   @default(false)
  twoFactorSecret    String?   @db.VarChar(500)
  createdAt          DateTime  @default(now()) @db.Timestamp(6)
  updatedAt          DateTime? @updatedAt @db.Timestamp(6)

  // Relacje
  facility           Facility                @relation(fields: [facilityId], references: [id])
  facilityAccesses   EmployeeFacilityAccess[]
  timeEvents         TimeEvent[]
  certifications     EmployeeCertification[]
  contracts          Contract[]
  documents          Document[]
  absences           Absence[]
  timeEntries        TimeEntry[]
  assignments        EmployeeAssignment[]
  generatedExports   PayrollExport[]
}

model EmployeeFacilityAccess {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @db.Uuid
  facilityId  String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([employeeId, facilityId])
  @@index([employeeId])
  @@index([facilityId])
}

model Project {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId   String        @db.Uuid // [NOWE] Przypisanie projektu do zakładu
  name         String        @db.VarChar(500)
  internalCode String?       @unique @db.VarChar(500)
  address      String?       @db.VarChar(500)
  status       ProjectStatus @default(ACTIVE)
  startDate    DateTime?     @db.Timestamp(6)
  endDate      DateTime?     @db.Timestamp(6)
  createdAt    DateTime      @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?     @updatedAt @db.Timestamp(6)

  // Relacje
  facility     Facility             @relation(fields: [facilityId], references: [id])
  timeEntries  TimeEntry[]
  assignments  EmployeeAssignment[]
  readers      Reader[]
}

model Reader {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId   String   @db.Uuid // [NOWE] Przypisanie czytnika do zakładu (nadrzędne)
  projectId    String   @db.Uuid
  serialNumber String   @unique @db.VarChar(255)
  locationName String?  @db.VarChar(500)
  isActive     Boolean  @default(true)

  // Relacje
  facility     Facility @relation(fields: [facilityId], references: [id])
  project      Project  @relation(fields: [projectId], references: [id])
  timeEvents   TimeEvent[]
}

model Contract {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String       @db.Uuid
  type         ContractType
  salaryAmount Decimal      @db.Decimal(12, 2)
  startDate    DateTime     @db.Timestamp(6)
  endDate      DateTime?    @db.Timestamp(6)
  isCurrent    Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?    @updatedAt @db.Timestamp(6)

  // Relacje
  employee     Employee     @relation(fields: [employeeId], references: [id])
  documents    Document[]
}

model EmployeeCertification {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId        String   @db.Uuid
  dictionaryId      String   @db.Uuid
  certificateNumber String?  @db.VarChar(500)
  issuedAt          DateTime @db.Timestamp(6)
  expiresAt         DateTime @db.Timestamp(6)
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime? @updatedAt @db.Timestamp(6)

  // Relacje
  employee          Employee                @relation(fields: [employeeId], references: [id])
  dictionary        CertificationDictionary @relation(fields: [dictionaryId], references: [id])
  documents         Document[]
}

model CertificationDictionary {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                  CertificationType
  name                  String            @unique @db.VarChar(500)
  description           String?           @db.Text
  defaultValidityMonths Int?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now()) @db.Timestamp(6)

  // Relacje
  certifications        EmployeeCertification[]
}

model TimeEvent {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String          @db.Uuid
  readerId   String          @db.Uuid
  action     TimeEventAction
  
  eventTime  DateTime        @db.Timestamp(6)
  createdAt  DateTime        @default(now()) @db.Timestamp(6)

  // Relacje
  employee   Employee        @relation(fields: [employeeId], references: [id])
  reader     Reader          @relation(fields: [readerId], references: [id])
}

model TimeEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollExportId String?  @db.Uuid
  employeeId      String   @db.Uuid
  projectId       String   @db.Uuid
  startTime       DateTime @db.Timestamp(6)
  endTime         DateTime @db.Timestamp(6)
  calculatedHours Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @db.Timestamp(6)

  // Relacje
  payrollExport   PayrollExport? @relation(fields: [payrollExportId], references: [id])
  employee        Employee       @relation(fields: [employeeId], references: [id])
  project         Project        @relation(fields: [projectId], references: [id])
}

model EmployeeAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String    @db.Uuid
  projectId    String    @db.Uuid
  assignedAt   DateTime  @default(now()) @db.Timestamp(6)
  unassignedAt DateTime? @db.Timestamp(6)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @db.Timestamp(6)

  // Relacje
  employee     Employee  @relation(fields: [employeeId], references: [id])
  project      Project   @relation(fields: [projectId], references: [id])
}

model Document {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String   @db.Uuid
  contractId      String?  @db.Uuid
  certificationId String?  @db.Uuid
  fileName        String   @db.VarChar(500)
  fileUrl         String   @db.Text
  createdAt       DateTime @default(now()) @db.Timestamp(6)

  // Relacje
  employee        Employee               @relation(fields: [employeeId], references: [id])
  contract        Contract?              @relation(fields: [contractId], references: [id])
  certification   EmployeeCertification? @relation(fields: [certificationId], references: [id])
  absences        Absence[]
}

model Absence {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String      @db.Uuid
  type       AbsenceType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  documentId String?     @db.Uuid
  isApproved Boolean     @default(false)
  createdAt  DateTime    @default(now()) @db.Timestamp(6)

  // Relacje
  employee   Employee    @relation(fields: [employeeId], references: [id])
  document   Document?   @relation(fields: [documentId], references: [id])
}

model PayrollExport {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodMonth       Int
  periodYear        Int
  generatedByUserId String   @db.Uuid
  totalEmployees    Int
  fileUrl           String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamp(6)

  // Relacje
  generatedByUser   Employee    @relation(fields: [generatedByUserId], references: [id])
  timeEntries       TimeEntry[]
}